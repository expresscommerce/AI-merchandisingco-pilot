# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Merchandising Co-Pilot
APP_VERSION=0.1.0
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merchandising
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/merchandising

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Secrets & AI Credentials ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ── Shopify App ─────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_app_api_key
SHOPIFY_API_SECRET=your_shopify_app_api_secret
SHOPIFY_REDIRECT_URI=http://localhost:8000/auth/shopify/callback
SHOPIFY_SCOPES=read_products,read_orders,write_products
FRONTEND_URL=http://localhost:5173
