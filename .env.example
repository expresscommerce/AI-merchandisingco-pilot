# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Merchandising Co-Pilot
APP_VERSION=0.1.0
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
